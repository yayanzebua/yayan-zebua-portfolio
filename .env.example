# ==============================================================================
# ENVIRONMENT CONFIGURATION (.env.local)
# Yayan Zebua Portfolio
# ==============================================================================

# Next.js Telemetry Configuration
NEXT_TELEMETRY_DISABLED="1"

# Email Delivery Gateway (Resend API)
# Obtain your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified Sender Address configured in Resend (e.g., onboarding@resend.dev or your custom domain)
RESEND_FROM_EMAIL="Yayan Zebua <onboarding@resend.dev>"

# Destination Inbox for incoming contact submissions
CONTACT_TO_EMAIL="yayanzebua15@gmail.com"

# Google reCAPTCHA v3 Configuration
# Obtain keys at: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_SECRET_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
RECAPTCHA_MIN_SCORE="0.5"
